{
  "name": "content-brief-to-seo-content-writer",
  "version": 1,
  "producer": "content-brief",
  "consumer": "seo-content-writer",
  "format": "json",
  "fixture": "fixtures/contracts/content-brief.json",
  "keys": [
    "id",
    "client",
    "page_url",
    "page_type",
    "primary_keyword",
    "secondary_keywords",
    "search_intent",
    "funnel",
    "metrics",
    "primary_question",
    "sub_questions",
    "entities",
    "banned_aliases",
    "evidence",
    "expert_quotes",
    "author",
    "first_hand",
    "internal_links",
    "answer_format",
    "format_directives",
    "word_range",
    "cta",
    "ymyl",
    "source_report"
  ],
  "producer_cmd": "python3 skills/content-brief/scripts/build_brief.py {fixture} --target fixtures/contracts/keyword-research-targets.json --sources fixtures/contracts/keyword-research-report.md fixtures/contracts/client-notes.md --out .harness/contract-brief.md --json-out -",
  "producer_output_equals_fixture": false,
  "consumer_cmd": "python3 skills/seo-content-writer/scripts/check_draft.py --brief {fixture} --brief-only"
}
