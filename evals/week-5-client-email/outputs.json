{
  "cases": [
    {
      "id": "marrowbrook-ready-protected-bugherd",
      "prompt": "Use the week-5-client-email skill. Draft the Week 5 staging review email for Marrowbrook Electric (slug marrowbrook-electric). It goes to Priya Raman; I'm Marco Silva, the AM. We send it today, Tuesday 2026-11-10. Staging is password protected (the guest password is Volt-Ridge-88) and Priya has guest access in BugHerd. The working folder is the current folder.",
      "fixtures": [
        {
          "src": "fixtures/week-5-client-email/marrowbrook/kickoff/marrowbrook-electric/marrowbrook-electric-context.md",
          "dest": "kickoff/marrowbrook-electric/marrowbrook-electric-context.md"
        },
        {
          "src": "fixtures/week-5-client-email/marrowbrook/client-reference/marrowbrook-electric/voice.md",
          "dest": "client-reference/marrowbrook-electric/voice.md"
        },
        {
          "src": "fixtures/week-5-client-email/marrowbrook/qa/marrowbrook-electric/marrowbrook-electric-staging-qa-2026-11-04.md",
          "dest": "qa/marrowbrook-electric/marrowbrook-electric-staging-qa-2026-11-04.md"
        },
        {
          "src": "fixtures/week-5-client-email/marrowbrook/qa/marrowbrook-electric/marrowbrook-electric-staging-qa-2026-11-09.md",
          "dest": "qa/marrowbrook-electric/marrowbrook-electric-staging-qa-2026-11-09.md"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md"
        },
        {
          "type": "max_words",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "n": 200,
          "label": "header plus a body under 150 words"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "^Client: Marrowbrook Electric\\n",
          "label": "starts with the header: no warning, the newest report is READY"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?m)^Send date: 2026-11-10$",
          "label": "send date"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?m)^Reply by: 2026-11-13$",
          "label": "three business days after Tuesday is Friday"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?m)^QA report: qa/marrowbrook-electric/marrowbrook-electric-staging-qa-2026-11-09\\.md \\(RESULT: READY\\)$",
          "label": "newest QA report named"
        },
        {
          "type": "not_contains",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "text": "WARNING",
          "label": "the older NOT READY report does not raise a warning"
        },
        {
          "type": "contains",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "text": "Friday, November 13",
          "label": "reply-by written out"
        },
        {
          "type": "contains",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "text": "https://marrowbrook.staging-wise.site",
          "label": "staging link"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?m)^Password: \\[AM: paste the staging password here\\]$",
          "label": "password placeholder for the AM"
        },
        {
          "type": "not_contains",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "text": "Volt-Ridge-88",
          "label": "the password is never written to the file"
        },
        {
          "type": "not_contains",
          "path": "stdout",
          "text": "Volt-Ridge-88",
          "label": "the password is not repeated in chat"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?i)bugherd",
          "label": "BugHerd offered as a way to send edits"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?i)go ahead",
          "label": "go-ahead line by default"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "(?m)^Hi Priya,$",
          "label": "greets Priya"
        },
        {
          "type": "regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "Marco Silva\\nAccount Manager, WISE Digital Partners\\s*$",
          "label": "default sign-off"
        },
        {
          "type": "not_regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "\\bQA\\b(?! report: )|(?i:punch list|severity|finding|noindex|launch toggle)|\\b(CRITICAL|MAJOR|MINOR)\\b",
          "label": "no internal terms outside the QA report header line"
        },
        {
          "type": "not_regex",
          "path": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "pattern": "!",
          "label": "voice.md email row: no exclamation marks"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "RESULT: PASS",
          "label": "the script check was run and passed"
        },
        {
          "type": "rubric",
          "target": "emails/marrowbrook-electric/marrowbrook-electric-week-5-email.md",
          "criteria": [
            "Below the Subject line, the email reads as a short, calm note from the account manager in the agency's own voice: it says the site is ready for the client's last check before launch, asks them to look for wrong facts, names, numbers, services and contact details, explains they can reply to the email or comment in BugHerd, gives one reply-by date, and says the agency will go ahead with the site as it is if there is no reply by then, without sounding pushy or like marketing copy. The line \"Password: [AM: paste the staging password here]\" is a deliberate slot the AM fills by hand before sending; it is not a defect."
          ],
          "context": [
            "client-reference/marrowbrook-electric/voice.md"
          ]
        }
      ]
    },
    {
