        },
        {
          "type": "not_regex",
          "path": "emails/fernhollow-bakery/fernhollow-bakery-week-5-email.md",
          "pattern": "(?is)Subject:.*(catering menu|ordering cart|not ready)",
          "label": "QA and AM items stay out of the email itself"
        },
        {
          "type": "regex",
          "path": "emails/fernhollow-bakery/fernhollow-bakery-week-5-email.md",
          "pattern": "Dana Whitfield\\nAccount Manager, WISE Digital Partners\\s*$",
          "label": "sign-off"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)not ready",
          "label": "tells the AM in chat that QA is not ready"
        }
      ]
    },
