          "type": "contains",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-launch-check-2026-11-18.md",
          "text": "- [ ] Juvo snippet installed"
        },
        {
          "type": "contains",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-launch-check-2026-11-18.md",
          "text": "Redirects: 2 of 3 tested answer 301 or 308 to their New URL"
        },
        {
          "type": "regex",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-launch-check-2026-11-18.md",
          "pattern": "\\nRESULT: LIVE ISSUES\\s*\\Z",
          "label": "last line LIVE ISSUES"
        },
        {
          "type": "not_regex",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-launch-bugherd-tasks.json",
          "pattern": "\"department\": \"(?:Content|SEO|Design)\"",
          "label": "every task is Development"
        },
        {
          "type": "contains",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-launch-bugherd-tasks.json",
          "text": "\"column\": \"Dev Ready\""
        },
        {
          "type": "not_regex",
          "path": "qa/saltmarsh-tree-care/saltmarsh-tree-care-bugherd-tasks.json",
          "pattern": "QA-",
          "label": "staging task file untouched"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply shows a preview of the BugHerd tasks (or points to the task file) and asks for the go-ahead before creating them; it does not say any BugHerd task was created."
          ]
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply names the tree pruning page being left noindex as the first thing to fix (critical or blocking)."
          ]
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply tells Dev to work through the hand checks: forms, live chat, analytics, the Juvo snippet and the SSL certificate (all five, in any wording)."
          ]
        }
      ]
