{
  "cases": [
    {
      "id": "larkspur-plan-preview",
      "prompt": "Set up the ClickUp plan for Larkspur Pet Clinic. Code LPC. Kickoff date 2026-11-16. AM Ana Field, PM Ben Okafor, SEO Sam Reyes, Editor Kit Moss, Designer Lia Chen, Developer Raj Patel. Paid media is not signed. The ClickUp connector is not available in this environment, so stop after the preview.",
      "fixtures": [],
      "assertions": [
        {
          "type": "file_exists",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json"
        },
        {
          "type": "file_exists",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-preview.md"
        },
        {
          "type": "file_absent",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-plan.md",
          "label": "nothing created, so no plan record"
        },
        {
          "type": "json_valid",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json",
          "text": "\"name\": \"[LPC] Larkspur Pet Clinic | Website Full Build\""
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-preview.md",
          "text": "Holidays skipped: 2026-11-26"
        },
        {
          "type": "regex",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-preview.md",
          "pattern": "\\| WD \\| Website Design \\| Week 1 · Website Design \\| Lia Chen \\| 2026-11-20 \\| 2026-12-11 \\| 9 \\| internal dependency \\|",
          "label": "Website Design D5 to D19, waits only on step 9"
        },
        {
          "type": "regex",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-preview.md",
          "pattern": "\\| 17 \\| Send the Week 1 email \\| Week 1 · Client Review \\| Ana Field \\| 2026-11-27 \\| 2026-11-27 \\| 14, 16 \\|",
          "label": "D9 lands after Thanksgiving"
        },
        {
          "type": "not_regex",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json",
          "pattern": "(?i)paid media \\(only if signed\\)|design brief|page-type"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json",
          "text": "\"dependencies\": 66"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-preview.md",
          "text": "PLAN: OK"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)\\byes\\b",
          "label": "asks for a yes before creating"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": "The answer shows a preview of the ClickUp list (list name, kickoff and last day, task and dependency counts) and asks the person to reply yes before anything is created. It does not claim that any list or task was created in ClickUp."
        }
      ]
    },
    {
      "id": "thornbury-test-run-from-kickoff",
      "prompt": "Make the test-run ClickUp list for Thornbury Roofing: code ZZZ, kickoff 2026-11-30, no assignees. Use the kickoff files in this folder to see whether paid media is signed. The ClickUp connector is not available here, so stop after the preview.",
      "fixtures": [
        {
          "src": "fixtures/clickup-build-setup/thornbury/kickoff/thornbury-roofing/thornbury-roofing-context.md",
          "dest": "kickoff/thornbury-roofing/thornbury-roofing-context.md"
        },
        {
          "src": "fixtures/clickup-build-setup/thornbury/kickoff/thornbury-roofing/thornbury-roofing-paid-media-brief.md",
          "dest": "kickoff/thornbury-roofing/thornbury-roofing-paid-media-brief.md"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json"
        },
        {
          "type": "contains",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json",
          "text": "\"name\": \"[ZZZ] TEST Thornbury Roofing | Website Full Build\""
        },
        {
          "type": "contains",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json",
          "text": "\"name\": \"Paid Media (only if signed)\"",
          "label": "paid media brief exists, so paid media tasks are planned"
        },
        {
          "type": "contains",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json",
          "text": "\"name\": \"TEST · Issues log\""
        },
        {
          "type": "contains",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json",
          "text": "\"schedule\": \"test\""
        },
        {
          "type": "contains",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-preview.md",
          "text": "last day 2026-12-18"
        },
        {
          "type": "not_regex",
          "path": "clickup/thornbury-roofing/thornbury-roofing-clickup-ops.json",
          "pattern": "\"assignee\": \"[^\"]"
        }
      ]
    },
    {
      "id": "larkspur-readback-check",
      "prompt": "The Larkspur Pet Clinic ClickUp list has been created from clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json, and I saved what ClickUp holds now as readback-after-create.json. Check the list against the plan and write the plan record. Don't call ClickUp; just tell me what's wrong and what you would fix.",
      "fixtures": [
        {
          "src": "fixtures/clickup-build-setup/larkspur/clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json",
          "dest": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json"
        },
        {
          "src": "fixtures/clickup-build-setup/larkspur/clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-readback.json",
          "dest": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-readback.json"
        },
        {
          "src": "fixtures/clickup-build-setup/larkspur/readback-after-create.json",
          "dest": "readback-after-create.json"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-plan.md"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-plan.md",
          "text": "RESULT: FAIL"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-plan.md",
          "text": "WD Website Design: due_date 2026-12-10, planned 2026-12-11"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-plan.md",
          "text": "W2-10 does not wait on W2-8"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "RESULT: FAIL"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": "The answer says the check failed, names the two tasks whose due dates are a day early (Website Design and Send the Week 1 email) and the missing dependency (Week 2 handoff check waiting on Send the Week 2 email), and says the fix is to reset those dates with a bulk date update and add the missing dependency, then read back and check again. It does not claim it changed anything in ClickUp."
        }
      ]
    },
    {
      "id": "larkspur-sitemap-pages",
      "prompt": "The sitemap is approved. Add the sitemap pages to ClickUp for Larkspur Pet Clinic. The list's latest readback is saved at clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-readback.json. The ClickUp connector is not available here, so stop after the preview.",
      "fixtures": [
        {
          "src": "fixtures/clickup-build-setup/larkspur/clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json",
          "dest": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-ops.json"
        },
        {
          "src": "fixtures/clickup-build-setup/larkspur/clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-readback.json",
          "dest": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-clickup-readback.json"
        },
        {
          "src": "fixtures/clickup-build-setup/larkspur/seo-reports/site-structure-optimizer/2026-11-24-larkspur-pet-clinic.md",
          "dest": "seo-reports/site-structure-optimizer/2026-11-24-larkspur-pet-clinic.md"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-page-subtasks.json"
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-page-subtasks.json",
          "text": "\"name\": \"Page: Dental Care (/services/dental-care)\""
        },
        {
          "type": "contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-page-subtasks.json",
          "text": "\"name\": \"Page: Privacy Policy (/privacy-policy)\""
        },
        {
          "type": "not_contains",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-page-subtasks.json",
          "text": "Page: Home (/)"
        },
        {
          "type": "regex",
          "path": "clickup/larkspur-pet-clinic/larkspur-pet-clinic-page-subtasks.json",
          "pattern": "\"skipped\": \\[\\s*\"Page: About \\(/about\\)\"\\s*\\]",
          "label": "existing page subtask is not added again"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "5 to create, 1 already there|5 (new )?(page )?subtasks?[^\\n]*1[^\\n]*already"
        }
      ]
    },
    {
      "id": "missing-code-asks",
      "prompt": "Set up the ClickUp plan for Orchard Lane Bakery, kickoff 2027-01-11, no paid media.",
      "fixtures": [],
      "assertions": [
        {
          "type": "file_absent",
          "path": "clickup/orchard-lane-bakery/orchard-lane-bakery-clickup-ops.json",
          "label": "no plan without a client code"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)code"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": "The answer asks for the three-character client code needed for the list name (for example [ABC]) and does not invent one or create anything."
        }
      ]
    }
  ]
}