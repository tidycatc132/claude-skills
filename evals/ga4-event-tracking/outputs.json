{
  "cases": [
    {
      "id": "fernwick-plan",
      "prompt": "Use the ga4-event-tracking skill. Fernwick Pest Control (slug fernwick-pest-control) is live. Set up the goal tracking events: GA4 measurement ID G-7QX3LM2K9P, GTM container GTM-W4K8P2Q. The working folder is the current folder.",
      "fixtures": [
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md",
          "dest": "handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md",
          "dest": "qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md"
        },
        {
          "type": "json_valid",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^Live: https://fernwickpest\\.com \\(from qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12\\.md\\)$",
          "label": "live address from the launch check"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^Measurement ID: G-7QX3LM2K9P$"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^GTM container: GTM-W4K8P2Q$"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^Lead event: form submission$"
        },
        {
          "type": "not_contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "text": "WARNING",
          "label": "no warning: index has analytics, contact page and a launch check"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^\\| `generate_lead` \\|[^\\n]*\\| yes \\| Contact \\(Book an Inspection\\) \\|$",
          "label": "lead event is a key event on the contact form"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^\\| `click_to_call` \\|[^\\n]*\\| yes \\| Home, Termite Treatment, Rodent Control, Contact \\(tel:\\+19785550147\\) \\|$",
          "label": "call links by page from the index"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "pattern": "(?m)^\\| `cta_click` \\|[^\\n]*\\| no \\| Home \\(Book an inspection\\); Termite Treatment",
          "label": "contact-page clicks from the index's internal links"
        },
        {
          "type": "contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json",
          "text": "\"value\": \"^(www\\\\.)?fernwickpest\\\\.com$\"",
          "label": "hostname guard in the container"
        },
        {
          "type": "contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json",
          "text": "\"type\": \"INIT\"",
          "label": "Google tag loads on a live-only Initialization trigger"
        },
        {
          "type": "contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json",
          "text": "\"value\": \"^(/contact)/?$\"",
          "label": "lead form trigger limited to the contact form page"
        },
        {
          "type": "contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json",
          "text": "\"type\": \"googtag\"",
          "label": "Google tag in the container"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)import",
          "label": "tells Dev to import the container"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply gives the tracking plan path and the GTM container file path, names the key events (generate_lead and click_to_call), and does not claim that the container has been imported, published or is firing, or that anything was changed in GTM or GA4."
          ]
        }
      ]
    },
    {
      "id": "oakmere-thank-you-plugin",
      "prompt": "Use the ga4-event-tracking skill for Oakmere Bookkeeping (slug oakmere-bookkeeping). The site is live at https://oakmerebooks.co.uk. GA4 is G-2BN8TR41VW and their WordPress plugin already loads it, so keep that. Their form sends people to /thank-you/. Make the tracking plan and the GTM import file. The working folder is the current folder.",
      "fixtures": [
        {
          "src": "fixtures/ga4-event-tracking/oakmere/handoff/oakmere-bookkeeping/oakmere-bookkeeping-dev-handoff-index.md",
          "dest": "handoff/oakmere-bookkeeping/oakmere-bookkeeping-dev-handoff-index.md"
        }
      ],
      "assertions": [
        {
          "type": "json_valid",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-gtm-container.json"
        },
        {
          "type": "regex",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-tracking-plan.md",
          "pattern": "(?m)^Live: https://oakmerebooks\\.co\\.uk \\(from --site\\)$"
        },
        {
          "type": "regex",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-tracking-plan.md",
          "pattern": "(?m)^Google tag: already on the site \\(not in container\\)$",
          "label": "no Google tag when the plugin loads GA4"
        },
        {
          "type": "not_contains",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-gtm-container.json",
          "text": "googtag",
          "label": "container has no Google tag"
        },
        {
          "type": "regex",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-tracking-plan.md",
          "pattern": "(?m)^Lead event: thank-you page /thank-you/$"
        },
        {
          "type": "contains",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-gtm-container.json",
          "text": "\"value\": \"^/thank\\\\-you/?$\"",
          "label": "thank-you page view trigger"
        },
        {
          "type": "not_contains",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-tracking-plan.md",
          "text": "`cta_click`",
          "label": "no contact page in the index, so no cta_click"
        },
        {
          "type": "regex",
          "path": "tracking/oakmere-bookkeeping/oakmere-bookkeeping-tracking-plan.md",
          "pattern": "(?m)^WARNING: the dev handoff index has no `### Analytics and tracking` section",
          "label": "warns about the missing analytics section"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)(contact page|cta_click)",
          "label": "reply mentions the missing contact page event"
        }
      ]
    },
    {
      "id": "fernwick-no-measurement-id",
      "prompt": "Use the ga4-event-tracking skill. Set up the GA4 event tracking for Fernwick Pest Control (slug fernwick-pest-control); the GTM container is GTM-W4K8P2Q. The working folder is the current folder.",
      "fixtures": [
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md",
          "dest": "handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md",
          "dest": "qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md"
        }
      ],
      "assertions": [
        {
          "type": "file_absent",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "label": "no plan without a Measurement ID"
        },
        {
          "type": "file_absent",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json"
        },
        {
          "type": "regex",
          "path": "stdout",
          "pattern": "(?i)measurement id",
          "label": "asks for the Measurement ID"
        }
      ]
    },
    {
      "id": "fernwick-site-check",
      "prompt": "Use the ga4-event-tracking skill. Dev imported and published the Fernwick Pest Control container (slug fernwick-pest-control). Check the tracking is installed using the saved live pages in the live folder, not the internet. Date the check 2026-11-14. The working folder is the current folder.",
      "fixtures": [
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md",
          "dest": "handoff/fernwick-pest-control/fernwick-pest-control-dev-handoff-index.md"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/base/qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md",
          "dest": "qa/fernwick-pest-control/fernwick-pest-control-launch-check-2026-11-12.md"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/planned/tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json",
          "dest": "tracking/fernwick-pest-control/fernwick-pest-control-gtm-container.json"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/planned/tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md",
          "dest": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-plan.md"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/about/index.html",
          "dest": "live/about/index.html"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/contact/index.html",
          "dest": "live/contact/index.html"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/index.html",
          "dest": "live/index.html"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/services/rodent-control/index.html",
          "dest": "live/services/rodent-control/index.html"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/services/termite-treatment/index.html",
          "dest": "live/services/termite-treatment/index.html"
        },
        {
          "src": "fixtures/ga4-event-tracking/fernwick/live/townsend-pest-control/index.html",
          "dest": "live/townsend-pest-control/index.html"
        }
      ],
      "assertions": [
        {
          "type": "file_exists",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-check-2026-11-14.md"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-check-2026-11-14.md",
          "pattern": "RESULT: TRACKING ISSUES\\n*\\Z",
          "label": "ends with the issues result"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-check-2026-11-14.md",
          "pattern": "(?m)^\\| Termite Treatment \\| /services/termite-treatment/ \\| no \\|",
          "label": "page without the container"
        },
        {
          "type": "regex",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-check-2026-11-14.md",
          "pattern": "(?m)^\\| Rodent Control \\| /services/rodent-control/ \\| yes \\| yes \\|",
          "label": "doubled GA4 tag"
        },
        {
          "type": "contains",
          "path": "tracking/fernwick-pest-control/fernwick-pest-control-tracking-check-2026-11-14.md",
          "text": "the index lists a contact form but the page HTML has no <form> element",
          "label": "form in an iframe"
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply says the check found tracking issues and names the three pages with problems: Termite Treatment (container missing), Rodent Control (GA4 loaded twice) and Contact (the form cannot be seen by the form trigger)."
          ]
        },
        {
          "type": "rubric",
          "target": "stdout",
          "criteria": [
            "The reply says the events still have to be tested by hand in GTM Preview or GA4 DebugView, and does not claim the events are confirmed to be arriving in GA4."
          ]
        }
      ]
    }
  ]
}