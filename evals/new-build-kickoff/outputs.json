          "column": "page_type",
          "values": [
            "home",
            "about",
            "service",
            "location",
            "contact",
            "blog",
            "post",
            "legal",
            "other"
          ]
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-context.md",
          "pattern": "(?m)^SOW pages: 12\\b",
          "label": "page count taken from the SOW"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-context.md",
          "pattern": "(?i)\\b(15|fifteen)\\b[^\\n]{0,120}(page|transcript|sales|call)|(transcript|sales|call)[^\\n]{0,120}\\b(15|fifteen)\\b",
          "label": "Sales call's fifteen pages flagged against the SOW"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-context.md",
          "pattern": "(?i)tankless",
          "label": "growth priority captured"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-context.md",
          "pattern": "(?i)Rooter Bros",
          "label": "competitor from the transcript captured"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?ms)^\\s*1\\.\\s.*^\\s*2\\.\\s.*^\\s*3\\.\\s",
          "label": "at least 3 numbered questions"
        },
        {
          "type": "not_regex",
