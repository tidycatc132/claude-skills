          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-context.md"
        },
        {
          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-url-inventory.csv"
        },
        {
          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md"
        },
        {
          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-project-instructions.md"
        },
        {
          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-setup-checklist.md"
        },
        {
          "type": "file_exists",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-paid-media-brief.md"
        },
        {
          "type": "file_absent",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-brand-brief-draft.md"
