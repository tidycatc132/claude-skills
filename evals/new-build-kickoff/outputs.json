      "id": "copperline-full-kickoff",
      "prompt": "Use the new-build-kickoff skill. Kick off Copperline Plumbing, copperlineplumbing.com, Tacoma metro. There is no WebFetch, WebSearch or internet access in this session. The Sales transcript is in `sales/`, the signed SOW is `sow.md`, and the client's website was saved yesterday to `site/` (one HTML file per page plus `sitemap.xml`); treat those files as the site crawl.",
      "fixtures": [
        {
          "src": "fixtures/new-build-kickoff/copperline/sales/sales-call-2026-09-30.txt",
          "dest": "sales/sales-call-2026-09-30.txt"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/sow.md",
          "dest": "sow.md"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/site/index.html",
          "dest": "site/index.html"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/site/about.html",
          "dest": "site/about.html"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/site/services.html",
          "dest": "site/services.html"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/site/contact.html",
          "dest": "site/contact.html"
        },
        {
          "src": "fixtures/new-build-kickoff/copperline/site/sitemap.xml",
          "dest": "site/sitemap.xml"
        }
      ],
