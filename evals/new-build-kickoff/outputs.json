          "pattern": "(?m)^Answer:\\s*$",
          "label": "blank Answer lines for the intake form"
        },
        {
          "type": "not_regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?im)^\\s*[1-5]\\.\\s[^\\n]*(competitor|compet|rank above)",
          "label": "does not ask what the transcript answered (competitors)"
        },
        {
          "type": "not_regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?im)^\\s*[1-5]\\.\\s[^\\n]*(service area|which cities|areas do you serve|main conversion|how do customers contact)",
          "label": "does not ask what the transcript answered (area, conversion)"
