          "pattern": "(?i)keyword-research|site-structure-optimizer|seo-content-writer|content-quality-auditor|client-reference-kit",
          "label": "no skill list in the instructions"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-setup-checklist.md",
          "pattern": "(?i)kickoff call",
          "label": "checklist names the Kickoff Call"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-setup-checklist.md",
          "pattern": "(?i)handoff check",
          "label": "checklist ends with the handoff check"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-paid-media-brief.md",
          "pattern": "2,500",
          "label": "paid media brief quotes the managed spend from the SOW"
        },
        {
          "type": "rubric",
          "target": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "label": "gaps are real gaps",
          "criteria": [
            "Every numbered question asks about something the Sales transcript, the website and the SOW together leave unanswered for planning the build (for example launch timing, URLs that must be kept, residential versus commercial mix, concrete proof points, what 'honest' means in practice, or which of the four cities named in the transcript get the SOW's three location pages). No question re-asks which services they offer, which areas they serve in general, who their competitors are, or how customers contact them, which the transcript answers."
          ]
        },
        {
          "type": "rubric",
          "target": "kickoff/copperline-plumbing/copperline-plumbing-context.md",
          "label": "context is sourced",
          "criteria": [
            "Facts in the context document are attributed to where they came from (transcript, site, SOW, or [user] for what the kickoff request itself states: client name, URL, Tacoma metro, kickoff date), and nothing appears that is not in those sources: no invented review counts, ratings, years, team sizes or prices. Founded 2006 and nine trucks are acceptable because the transcript and site state them."
          ]
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?ms)^## Checklist Coverage.*^\\|\\s*R1\\s*\\|.*^\\|\\s*R10\\s*\\|",
          "label": "coverage table R1 to R10"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?m)^\\|\\s*R7\\s*\\|[^\\n]*\\|\\s*covered\\s*\\|",
          "label": "R7 covered from the SOW"
        },
        {
          "type": "regex",
          "target": "stdout",
          "pattern": "RESULT: PASS",
          "label": "checker passed"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-setup-checklist.md",
          "pattern": "(?i)send the paid media brief to paid media",
          "label": "checklist sends the paid media brief"
        },
        {
          "type": "regex",
          "path": "kickoff/copperline-plumbing/copperline-plumbing-gap-questions.md",
          "pattern": "(?m)^\\|\\s*R6\\s*\\|[^\\n]*\\|\\s*covered\\s*\\|",
          "label": "R6 competitors covered by the transcript"
        }
      ]
    },
